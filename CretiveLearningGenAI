<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta property="og:title" content="Reframing Creative Learning: Design Literacy in the GenAI Era">
<meta property="og:description" content="An interactive conceptual framework. Four planes of competency, nine action components, explored through an architectural design task.">
<title>Reframing Creative Learning · Interactive Framework</title>
<style>
  :root{
    --ink:#10243b;
    --ink-2:#1b3a5c;
    --ink-3:#4a627c;
    --paper:#eef2f1;
    --paper-2:#e3e9e8;
    --line:#9fb2b8;
    --line-soft:#c4d0d1;
    --signal:#e0742d;
    --signal-soft:#f3c79f;
    --epi:#2d6e7e;
    --ope:#3a7d5c;
    --eth:#a8593a;
    --ref:#6a5a8c;
    --white:#fbfcfb;
    --shadow:rgba(16,36,59,.16);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:
      linear-gradient(rgba(16,36,59,.025) 1px,transparent 1px) 0 0/26px 26px,
      linear-gradient(90deg,rgba(16,36,59,.025) 1px,transparent 1px) 0 0/26px 26px,
      var(--paper);
    color:var(--ink);
    font-family:"Helvetica Neue",Arial,sans-serif;
    line-height:1.5;-webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  @media (prefers-reduced-motion:reduce){*{animation-duration:.001ms!important;transition-duration:.001ms!important}}
  .wrap{max-width:1080px;margin:0 auto;padding:0 20px}

  /* ---------- header ---------- */
  header{padding:44px 0 8px;text-align:center}
  .eyebrow{font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--ink-2);font-weight:700;opacity:.75;margin-bottom:18px}
  h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(28px,5vw,46px);line-height:1.08;letter-spacing:-.01em;color:var(--ink)}
  h1 em{font-style:italic;color:var(--signal)}
  .sub{max-width:640px;margin:18px auto 0;font-size:15.5px;color:var(--ink-2)}
  .byline{margin-top:16px;font-size:13px;letter-spacing:.02em;color:var(--ink-2)}
  .byline a{color:var(--signal);text-decoration:none;font-weight:600}
  .byline a:hover{text-decoration:underline}
  .affil{margin-top:6px;font-size:12px;color:var(--ink-3);line-height:1.5}
  .venue{margin-top:10px;font-size:11.5px;letter-spacing:.04em;color:var(--ink-3);font-style:italic}

  /* ---------- mode toggle ---------- */
  .modes{display:flex;justify-content:center;gap:0;margin:30px auto 8px;border:1px solid var(--ink);border-radius:2px;width:max-content;max-width:100%;overflow:hidden;background:var(--white)}
  .modes button{font-family:inherit;font-size:12px;letter-spacing:.12em;text-transform:uppercase;font-weight:700;padding:11px 20px;border:0;background:transparent;color:var(--ink);cursor:pointer;transition:background .2s,color .2s;white-space:nowrap}
  .modes button+button{border-left:1px solid var(--line-soft)}
  .modes button.on{background:var(--ink);color:var(--paper)}
  .hint{text-align:center;font-size:12.5px;color:var(--ink-2);opacity:.85;margin:4px 0 0;min-height:18px}

  /* ---------- explore stage ---------- */
  .stage{position:relative;margin:18px auto 10px;padding:18px 0 6px}
  .rail{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;position:relative}
  .rail::before{content:"";position:absolute;top:46px;left:8%;right:8%;height:2px;background:repeating-linear-gradient(90deg,var(--line) 0 8px,transparent 8px 16px);z-index:0}
  .plane{position:relative;z-index:1;background:var(--white);border:1.5px solid var(--ink);border-radius:3px;padding:0;cursor:pointer;text-align:left;font-family:inherit;color:var(--ink);
    transition:transform .25s cubic-bezier(.2,.7,.3,1),box-shadow .25s,border-color .25s;box-shadow:0 1px 0 var(--line-soft);display:flex;flex-direction:column;min-height:150px}
  .plane:hover{transform:translateY(-4px);box-shadow:0 10px 22px var(--shadow)}
  .plane:focus-visible{outline:3px solid var(--signal);outline-offset:3px}
  .plane .cap{display:flex;align-items:center;gap:8px;padding:9px 12px 8px;border-bottom:1px solid var(--line-soft)}
  .plane .gly{width:30px;height:30px;flex:0 0 auto;margin-left:auto}
  .plane .layer{font-size:9.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-2);opacity:.7;font-weight:700}
  .plane .name{padding:9px 12px 4px;font-family:Georgia,serif;font-size:17px;line-height:1.12}
  .plane .role{padding:0 12px 12px;font-size:11.5px;color:var(--ink-2);line-height:1.35}
  .plane .tick{position:absolute;left:50%;top:-9px;transform:translateX(-50%);width:14px;height:14px;background:var(--white);border:1.5px solid var(--ink);border-radius:50%;display:none;z-index:2}
  .plane.active{box-shadow:0 12px 26px var(--shadow)}
  .plane.active .tick{display:block}
  .plane[data-p="epi"] .layer{color:var(--epi);opacity:1}
  .plane[data-p="ope"] .layer{color:var(--ope);opacity:1}
  .plane[data-p="eth"] .layer{color:var(--eth);opacity:1}
  .plane[data-p="ref"] .layer{color:var(--ref);opacity:1}
  .plane[data-p="epi"].active{border-color:var(--epi)}
  .plane[data-p="ope"].active{border-color:var(--ope)}
  .plane[data-p="eth"].active{border-color:var(--eth)}
  .plane[data-p="ref"].active{border-color:var(--ref)}
  .plane[data-p="epi"].active .tick{background:var(--epi);border-color:var(--epi)}
  .plane[data-p="ope"].active .tick{background:var(--ope);border-color:var(--ope)}
  .plane[data-p="eth"].active .tick{background:var(--eth);border-color:var(--eth)}
  .plane[data-p="ref"].active .tick{background:var(--ref);border-color:var(--ref)}
  .arrow{position:absolute;top:40px;z-index:1;color:var(--line);font-size:13px;transform:translateX(-50%)}

  /* ---------- components tray ---------- */
  .tray{margin:22px auto 0;border-top:1px dashed var(--line);padding-top:18px}
  .tray-head{display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:6px;margin-bottom:6px}
  .tray-head h2{font-family:Georgia,serif;font-weight:400;font-size:18px}
  .tray-head .count{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--ink-2);opacity:.75}
  .tray-note{font-size:12px;color:var(--ink-3);margin-bottom:13px;max-width:64ch;line-height:1.45}
  .comps{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .comp{background:var(--white);border:1px solid var(--line-soft);border-radius:3px;padding:11px 12px;cursor:pointer;font-family:inherit;text-align:left;color:var(--ink);
    transition:transform .2s,box-shadow .2s,border-color .2s,opacity .25s,background .2s;position:relative;overflow:hidden}
  .comp .barwrap{position:absolute;left:0;top:0;bottom:0;width:4px;display:flex;flex-direction:column}
  .comp .barwrap i{flex:1;background:var(--line-soft);transition:background .2s}
  .comp:hover{transform:translateY(-2px);box-shadow:0 6px 14px var(--shadow)}
  .comp:focus-visible{outline:3px solid var(--signal);outline-offset:2px}
  .comp .ci{font-size:9.5px;letter-spacing:.1em;color:var(--ink-2);opacity:.6;font-weight:700;display:block;margin-bottom:3px;padding-left:6px}
  .comp .cn{font-size:13px;font-weight:700;line-height:1.2;padding-left:6px}
  .comp .cserve{font-size:9.5px;color:var(--ink-3);padding-left:6px;margin-top:4px;letter-spacing:.02em}
  .comp.dim{opacity:.26}
  .comp.lit{border-color:var(--ink-2)}

  /* ---------- detail panel ---------- */
  .panel{margin:24px auto 0;background:var(--ink);color:var(--paper);border-radius:4px;padding:0;overflow:hidden;max-height:0;opacity:0;transition:max-height .42s ease,opacity .3s ease}
  .panel.open{max-height:560px;opacity:1}
  .panel-in{padding:22px 24px 24px;position:relative}
  .panel .ptag{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;opacity:.6;font-weight:700;margin-bottom:8px}
  .panel h3{font-family:Georgia,serif;font-weight:400;font-size:23px;margin-bottom:9px;color:var(--white);display:flex;align-items:center;gap:11px}
  .panel h3 .gm{width:28px;height:28px;flex:0 0 auto}
  .panel p{font-size:14.5px;line-height:1.55;color:#cdd9e2;max-width:64ch}
  .panel .meta{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px}
  .chip{font-size:10.5px;letter-spacing:.04em;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:5px 11px;color:#dbe6ee}
  .chip b{color:var(--signal-soft);font-weight:700}
  .panel .ex{margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.14)}
  .panel .ex .exl{font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--signal-soft);font-weight:700;margin-bottom:5px}
  .panel .ex p{font-size:13.5px;color:#c3d0da;font-style:italic}
  .closex{position:absolute;top:14px;right:16px;background:transparent;border:0;color:#aebccb;font-size:20px;cursor:pointer;line-height:1}
  .closex:hover{color:#fff}

  /* ---------- walkthrough ---------- */
  .walk{margin:14px auto 0}
  .walk-bar{display:flex;align-items:center;justify-content:center;gap:14px;margin-bottom:8px;flex-wrap:wrap}
  .walk-bar button{font-family:inherit;font-size:12px;font-weight:700;letter-spacing:.06em;padding:9px 18px;border:1.5px solid var(--ink);background:var(--white);color:var(--ink);border-radius:2px;cursor:pointer;transition:background .2s,color .2s,opacity .2s}
  .walk-bar button:hover:not(:disabled){background:var(--ink);color:var(--paper)}
  .walk-bar button:disabled{opacity:.35;cursor:default}
  .walk-bar .pos{font-size:12px;letter-spacing:.1em;color:var(--ink-2);font-weight:700;min-width:54px;text-align:center}
  .dots{display:flex;gap:6px;justify-content:center;margin-top:2px}
  .dots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:background .25s,transform .25s;cursor:pointer}
  .dots i.on{background:var(--signal);transform:scale(1.35)}

  .scene{margin-top:16px;background:var(--white);border:1px solid var(--line-soft);border-radius:4px;overflow:hidden;
    display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr)}
  .scene .viz{background:var(--paper-2);border-right:1px solid var(--line-soft);display:flex;align-items:center;justify-content:center;padding:18px;min-height:300px}
  .scene .viz svg{width:100%;height:auto;max-height:340px;display:block}
  .scene .viz .fig{margin:0;width:100%;display:flex;flex-direction:column;gap:10px}
  .scene .viz .fig img{width:100%;height:auto;display:block;border:1px solid var(--line-soft);border-radius:3px;background:#fff}
  .scene .viz .fig figcaption{font-size:10.5px;letter-spacing:.04em;color:var(--ink-3);text-align:center;line-height:1.4}
  .scene .viz .figs{gap:8px}
  .scene .viz .figs img+img{margin-top:0}
  .scene.noviz{grid-template-columns:1fr}
  .scene.noviz .stext{padding:30px 34px}
  .scene.noviz .stext p{max-width:68ch}
  .scene .stext{padding:24px 26px}
  .scene .sk{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;margin-bottom:9px;display:flex;align-items:center;gap:8px;color:var(--ink-2)}
  .scene .sk .d{width:10px;height:10px;border-radius:50%}
  .scene h3{font-family:Georgia,serif;font-weight:400;font-size:23px;line-height:1.1;margin-bottom:11px}
  .scene p{font-size:14.5px;color:var(--ink-2);line-height:1.58;max-width:54ch}
  .scene .q{margin-top:13px;font-size:13.5px;color:var(--ink);background:var(--paper);border-left:3px solid var(--signal);padding:9px 13px;border-radius:0 3px 3px 0}
  .scene .q b{font-weight:700}
  .scene .uses{margin-top:14px;display:flex;flex-wrap:wrap;gap:6px}
  .scene .uses .u{font-size:10.5px;letter-spacing:.02em;border:1px solid var(--line-soft);background:var(--paper);border-radius:999px;padding:4px 10px;color:var(--ink-2)}

  .hide{display:none!important}

  footer{margin:40px 0 30px;text-align:center;border-top:1px solid var(--line-soft);padding-top:20px}
  footer p{font-size:12px;color:var(--ink-2);opacity:.85;line-height:1.65}
  footer a{color:var(--signal);text-decoration:none}
  footer a:hover{text-decoration:underline}

  @media (max-width:860px){
    .rail{grid-template-columns:repeat(2,1fr);gap:12px}
    .rail::before{display:none}
    .arrow{display:none}
    .comps{grid-template-columns:repeat(2,1fr)}
    .scene{grid-template-columns:1fr}
    .scene .viz{border-right:0;border-bottom:1px solid var(--line-soft);min-height:auto}
  }
  @media (max-width:520px){
    header{padding:30px 0 4px}
    .rail{grid-template-columns:1fr}
    .comps{grid-template-columns:1fr}
    .plane{min-height:auto}
    .modes button{padding:10px 14px;font-size:11px}
    .walk-bar{gap:8px}
    .panel.open{max-height:760px}
  }
</style>
</head>
<body>

<div class="wrap">
  <header>
    <div class="eyebrow">Conceptual Framework · iConference 2026</div>
    <h1>Reframing creative learning:<br>design literacy in the <em>GenAI era</em></h1>
    <p class="sub">A design task moves through four planes of judgment, drawing on nine action components, so that curiosity, iteration, and originality hold their ground when generative AI enters the studio.</p>
    <p class="byline">Asif Hasan Zeshan &amp; <a href="https://infosci.arizona.edu/person/xiao-hu" target="_blank" rel="noopener">Xiao Hu, PhD</a></p>
    <p class="affil">University of Arizona, College of Information Science</p>
    <p class="venue">Presented at iConference 2026, hosted by Edinburgh Napier University</p>
  </header>

  <div class="modes" role="tablist" aria-label="View mode">
    <button id="mExplore" class="on" role="tab" aria-selected="true">Explore</button>
    <button id="mWalk" role="tab" aria-selected="false">Walkthrough</button>
  </div>
  <p class="hint" id="hint">Hover a component to see the planes it serves. Click any plane or component for detail.</p>

  <!-- ============ EXPLORE ============ -->
  <section class="stage" id="exploreView">
    <div class="rail" id="rail"></div>

    <div class="tray">
      <div class="tray-head">
        <h2>Nine action components</h2>
        <span class="count">Re-clustered per task</span>
      </div>
      <p class="tray-note">Components are not fixed to a single plane. Each has a home plane where it does its main work, yet many serve more than one, recombining as the design task demands. The coloured marks on each card show every plane it can support.</p>
      <div class="comps" id="comps"></div>
    </div>

    <div class="panel" id="panel" aria-live="polite">
      <div class="panel-in">
        <button class="closex" id="closeP" aria-label="Close detail">×</button>
        <div class="ptag" id="pTag"></div>
        <h3 id="pTitle"></h3>
        <p id="pBody"></p>
        <div class="meta" id="pMeta"></div>
        <div class="ex" id="pEx">
          <div class="exl">In the desert-home task</div>
          <p id="pExBody"></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WALKTHROUGH ============ -->
  <section class="stage hide" id="walkView">
    <div class="walk">
      <div class="walk-bar">
        <button id="prev" disabled>‹ Back</button>
        <span class="pos" id="pos">1 / 7</span>
        <button id="next">Next ›</button>
      </div>
      <div class="dots" id="dots"></div>
      <div class="scene" id="scene"></div>
    </div>
  </section>

  <footer>
    <p><strong>Reframing creative learning: a conceptual framework for design literacy in the GenAI era</strong><br>
    Asif Hasan Zeshan &amp; <a href="https://infosci.arizona.edu/person/xiao-hu" target="_blank" rel="noopener">Xiao Hu, PhD</a> · University of Arizona, College of Information Science<br>
    Presented at iConference 2026, Edinburgh Napier University · <em>Information Research</em>, 31(iConf), 317–327<br>
    <a href="https://doi.org/10.47989/ir31iConf64273" target="_blank" rel="noopener">doi.org/10.47989/ir31iConf64273</a></p>
  </footer>
</div>

<script>
(function(){
  "use strict";

  /* ---------------- plane glyphs ---------------- */
  var GLY={
    epi:'<svg viewBox="0 0 40 40" fill="none" stroke="var(--epi)" stroke-width="1.5"><circle cx="20" cy="20" r="13"/><path d="M20 7v26M7 20h26"/><circle cx="20" cy="20" r="4" fill="var(--epi)" stroke="none"/></svg>',
    ope:'<svg viewBox="0 0 40 40" fill="none" stroke="var(--ope)" stroke-width="1.5"><rect x="7" y="7" width="26" height="26"/><path d="M11 27l6-6 5 5 8-10"/><path d="M27 16h3v3"/></svg>',
    eth:'<svg viewBox="0 0 40 40" fill="none" stroke="var(--eth)" stroke-width="1.5"><path d="M20 6l11 5v8c0 8-5 12-11 15-6-3-11-7-11-15v-8z"/><path d="M20 15v8M20 27v.3"/></svg>',
    ref:'<svg viewBox="0 0 40 40" fill="none" stroke="var(--ref)" stroke-width="1.5"><path d="M11 29a11 11 0 1 1 18 0"/><path d="M14 29h12M16 33h8"/><path d="M20 8v3"/></svg>'
  };
  function gm(p){return GLY[p];}
  var nameOf={epi:"Epistemic",ope:"Operational",eth:"Ethical–Legal",ref:"Reflective"};
  var colorVar={epi:"var(--epi)",ope:"var(--ope)",eth:"var(--eth)",ref:"var(--ref)"};
  function cssColor(p){return getComputedStyle(document.documentElement).getPropertyValue('--'+p).trim();}

  var PLANES=[
    {p:"epi",layer:"Plane 01",name:"Epistemic",role:"Is the AI's output true and credible?",
     tag:"Plane 01 · Truth & credibility",
     body:"The first checkpoint. Generative AI can blur the line between fact and fabrication, so this plane asks whether an output can be trusted at all, tracing where it came from, flagging how confident it is, and rejecting anything that contradicts what is known.",
     ex:"The learner examines the sources and assumptions behind AI-generated climate references for the desert site, and tests whether proposed layouts respond realistically to heat and orientation."},
    {p:"ope",layer:"Plane 02",name:"Operational",role:"Can I work the AI tool skilfully?",
     tag:"Plane 02 · Technical capacity",
     body:"Once outputs can be trusted, this plane is about working the tool well, shaping precise prompts and looping through generate, test, and refine cycles, so the learner harnesses the AI's power while staying in command of the result.",
     ex:"Prompts specify orientation, shading intent, and room adjacency; the learner iterates across cycles of generated floorplans while keeping authorship over the final layout."},
    {p:"eth",layer:"Plane 03",name:"Ethical–Legal",role:"Is it responsible and transparent?",
     tag:"Plane 03 · Responsibility & transparency",
     body:"Good output and good craft still call for a conscience. This plane checks AI results for bias or harm, and insists on disclosing where the AI contributed, keeping the human answerable for ethics and compliance.",
     ex:"Bias reviews ask whether generated layouts simply copy existing homes or impose unsuitable conventions; authorship disclosure makes the AI's role explicit, and building codes are taught and evaluated directly."},
    {p:"ref",layer:"Plane 04",name:"Reflective",role:"Why did I make these choices?",
     tag:"Plane 04 · Metacognition",
     body:"The final plane steps back. Reflective critique asks why choices were made and whether they hold up, addressing the why of action, its reasons and its consequences. This is where design literacy deepens over time.",
     ex:"The learner articulates why certain AI options were accepted, modified, or rejected, and how those decisions align with functional goals and professional values."}
  ];

  /* components: home plane + also-serves planes (cross-use, per paper) */
  var COMPS=[
    {id:"prov",n:"Provenance tracing",home:"epi",also:["eth"],
     d:"Records where data or an AI output came from, so its authenticity can be verified. Its trail also feeds authorship and accountability work on the ethical plane.",
     ex:"Checking the sources and assumptions behind AI-generated climate references."},
    {id:"unc",n:"Uncertainty tagging",home:"epi",also:["ref"],
     d:"Attaches confidence scores to outputs so learners can judge how far to rely on them. The same scores later inform reflective judgement about which options to trust.",
     ex:"Flagging layout claims that rest on generalised or probabilistic assumptions."},
    {id:"tri",n:"Cross-modal triangulation",home:"epi",also:["ope"],
     d:"Compares results across modalities, text, image, and video, to check they stay consistent. The comparison habit carries into operational testing of variants.",
     ex:"Cross-checking a generated plan against solar simulation imagery for the same site."},
    {id:"pla",n:"Plausibility checks",home:"epi",also:["ope","ref"],
     d:"Uses domain expertise and common sense to reject outputs that contradict established facts. It guides which prototypes are worth refining and what to question on reflection.",
     ex:"Asking whether shading and solar orientation are realistic for desert conditions."},
    {id:"pro",n:"Prompt engineering",home:"ope",also:["epi"],
     d:"Crafting and refining input instructions that steer the model toward relevant responses. Sharper prompts also surface more traceable, checkable outputs for the epistemic plane.",
     ex:"Specifying orientation, shading intent, and adjacency in the prompt."},
    {id:"ite",n:"Iterative prototyping",home:"ope",also:["ref"],
     d:"Generates design variants with AI and refines them over successive cycles. Each cycle gives the reflective plane fresh material to weigh and learn from.",
     ex:"Producing two floorplans, then looping to compare and improve them."},
    {id:"bia",n:"Bias & harm review",home:"eth",also:["epi"],
     d:"Examines outputs for unfair bias or harm and proposes mitigations. The scrutiny overlaps with epistemic checks on whether an output reflects reality fairly.",
     ex:"Asking if layouts are culturally invasive, inequitable, or merely copied."},
    {id:"aut",n:"Authorship disclosure",home:"eth",also:["ref"],
     d:"Transparently acknowledges where AI contributed to content or decisions. Naming the AI's share also sharpens the learner's reflection on their own role.",
     ex:"Marking which parts of the design came from the AI and which from the learner."},
    {id:"refc",n:"Reflective critique",home:"ref",also:["ope","eth"],
     d:"Compels learners to reflect on the process and how to improve the creative outcome. It reaches back into operational and ethical decisions, asking why each was made.",
     ex:"Reasoning through why one iteration was accepted over another."}
  ];

  function planesFor(c){return [c.home].concat(c.also);}

  /* ---------------- build planes ---------------- */
  var rail=document.getElementById('rail');
  PLANES.forEach(function(pl){
    var b=document.createElement('button');
    b.className='plane';b.setAttribute('data-p',pl.p);b.setAttribute('aria-label',pl.name+' plane');
    b.innerHTML='<span class="tick"></span>'+
      '<span class="cap"><span class="layer">'+pl.layer+'</span><span class="gly">'+gm(pl.p)+'</span></span>'+
      '<span class="name">'+pl.name+'</span>'+
      '<span class="role">'+pl.role+'</span>';
    rail.appendChild(b);
  });
  ['25%','50%','75%'].forEach(function(L){var a=document.createElement('span');a.className='arrow';a.style.left=L;a.textContent='▸';rail.appendChild(a);});

  /* ---------------- build components ---------------- */
  var compsEl=document.getElementById('comps');
  COMPS.forEach(function(c,i){
    var serves=planesFor(c);
    var bars=['epi','ope','eth','ref'].map(function(p){
      var on=serves.indexOf(p)>-1;
      return '<i data-bar="'+p+'" style="'+(on?'background:'+colorVar[p]:'')+'"></i>';
    }).join('');
    var label=nameOf[c.home]+(c.also.length?' +'+c.also.length:'');
    var b=document.createElement('button');
    b.className='comp';b.setAttribute('data-id',c.id);b.setAttribute('data-serves',serves.join(' '));
    b.innerHTML='<span class="barwrap">'+bars+'</span>'+
      '<span class="ci">C'+String(i+1).padStart(2,'0')+'</span>'+
      '<span class="cn">'+c.n+'</span>'+
      '<span class="cserve">'+label+'</span>';
    compsEl.appendChild(b);
  });

  var planeEls=[].slice.call(document.querySelectorAll('.plane'));
  var compEls=[].slice.call(document.querySelectorAll('.comp'));

  /* ---------------- panel ---------------- */
  var panel=document.getElementById('panel');
  var pTag=document.getElementById('pTag'),pTitle=document.getElementById('pTitle'),
      pBody=document.getElementById('pBody'),pMeta=document.getElementById('pMeta'),
      pExBody=document.getElementById('pExBody');

  function clearActive(){planeEls.forEach(function(p){p.classList.remove('active')});compEls.forEach(function(c){c.classList.remove('lit','dim')});}

  function showPlane(p){
    clearActive();
    document.querySelector('.plane[data-p="'+p+'"]').classList.add('active');
    compEls.forEach(function(c){
      var serves=c.getAttribute('data-serves').split(' ');
      if(serves.indexOf(p)>-1){c.classList.add('lit')} else {c.classList.add('dim')}
    });
    var pl=PLANES.filter(function(x){return x.p===p})[0];
    var rel=COMPS.filter(function(c){return planesFor(c).indexOf(p)>-1});
    pTag.textContent=pl.tag;
    pTitle.innerHTML='<span class="gm">'+gm(p)+'</span>'+pl.name+' plane';
    pBody.textContent=pl.body;
    pMeta.innerHTML=rel.map(function(c){
      var home=c.home===p;
      return '<span class="chip">'+(home?'<b>home · </b>':'serves · ')+c.n+'</span>';
    }).join('');
    pExBody.textContent=pl.ex;
    panel.classList.add('open');
  }

  function showComp(id){
    clearActive();
    var c=COMPS.filter(function(x){return x.id===id})[0];
    var serves=planesFor(c);
    document.querySelector('.comp[data-id="'+id+'"]').classList.add('lit');
    compEls.forEach(function(x){if(x.getAttribute('data-id')!==id)x.classList.add('dim')});
    serves.forEach(function(p){document.querySelector('.plane[data-p="'+p+'"]').classList.add('active')});
    pTag.textContent='Action component · home plane '+nameOf[c.home];
    pTitle.innerHTML='<span class="gm">'+gm(c.home)+'</span>'+c.n;
    pBody.textContent=c.d;
    pMeta.innerHTML=serves.map(function(p,i){
      return '<span class="chip">'+(i===0?'<b>home · </b>':'also serves · ')+nameOf[p]+'</span>';
    }).join('');
    pExBody.textContent=c.ex;
    panel.classList.add('open');
  }
  function closePanel(){panel.classList.remove('open');clearActive();}
  document.getElementById('closeP').addEventListener('click',closePanel);

  planeEls.forEach(function(p){p.addEventListener('click',function(){showPlane(p.getAttribute('data-p'))})});
  compEls.forEach(function(c){
    c.addEventListener('click',function(){showComp(c.getAttribute('data-id'))});
    c.addEventListener('mouseenter',function(){
      if(panel.classList.contains('open'))return;
      c.getAttribute('data-serves').split(' ').forEach(function(p){document.querySelector('.plane[data-p="'+p+'"]').classList.add('active')});
    });
    c.addEventListener('mouseleave',function(){
      if(panel.classList.contains('open'))return;
      planeEls.forEach(function(x){x.classList.remove('active')});
    });
  });

