     p:"Finally the learner steps back through reflective critique: why was this iteration accepted? How does it align with environmental ethics and functional needs? What assumptions shaped the prompts? Here a finished file becomes genuine learning.",
     q:"Why accept a <b>particular iteration</b>, how does it align with ethics and function, and what assumptions shaped my prompts?",
     uses:["Reflective critique","Uncertainty tagging","Authorship disclosure"]},
    {k:"Transfer · Why it matters",g:"signal",viz:VIZ_TRANSFER,t:"Creativity preserved across every context",
     p:"The same four planes and nine components apply far beyond architecture: in classrooms, in galleries, libraries, archives, and museums, and in self-directed everyday creativity. The aim stays constant throughout.",
     q:null,uses:[]}
  ];

  var idx=0;
  var scene=document.getElementById('scene'),pos=document.getElementById('pos'),
      prev=document.getElementById('prev'),next=document.getElementById('next'),dots=document.getElementById('dots');

  SCENES.forEach(function(_,i){var d=document.createElement('i');d.addEventListener('click',function(){idx=i;renderScene()});dots.appendChild(d);});
  var dotEls=[].slice.call(dots.children);

  function renderScene(){
    var s=SCENES[idx];var col=cssColor(s.g);
    var uses=s.uses&&s.uses.length?'<div class="uses">'+s.uses.map(function(u){return '<span class="u">'+u+'</span>'}).join('')+'</div>':'';
    var vizInner;
    if(s.imgs&&s.imgs.length){
      vizInner='<figure class="fig figs">'+
        s.imgs.map(function(im){return '<img src="'+im.src+'" alt="'+(im.alt||'Figure from the paper')+'"/>'}).join('')+
        (s.cap?'<figcaption>'+s.cap+'</figcaption>':'')+'</figure>';
    } else if(s.img){
      vizInner='<figure class="fig"><img src="'+s.img+'" alt="'+(s.alt||'Figure from the paper')+'"/>'+
        (s.cap?'<figcaption>'+s.cap+'</figcaption>':'')+'</figure>';
    } else if(s.viz){
      vizInner=s.viz();
    } else {
      vizInner='';
    }
    var hasViz=!!vizInner;
    scene.className='scene'+(hasViz?'':' noviz');
    scene.innerHTML=
      (hasViz?'<div class="viz">'+vizInner+'</div>':'')+
      '<div class="stext"><div class="sk"><span class="d" style="background:'+col+'"></span>'+s.k+'</div>'+
        '<h3>'+s.t+'</h3><p>'+s.p+'</p>'+
        (s.q?'<div class="q" style="border-color:'+col+'">'+s.q+'</div>':'')+uses+'</div>';
    pos.textContent=(idx+1)+' / '+SCENES.length;
    prev.disabled=idx===0;next.disabled=idx===SCENES.length-1;
    dotEls.forEach(function(d,i){d.classList.toggle('on',i===idx)});
  }
  prev.addEventListener('click',function(){if(idx>0){idx--;renderScene()}});
  next.addEventListener('click',function(){if(idx<SCENES.length-1){idx++;renderScene()}});
  document.addEventListener('keydown',function(e){
    if(wV.classList.contains('hide'))return;
    if(e.key==='ArrowRight'&&idx<SCENES.length-1){idx++;renderScene()}
    if(e.key==='ArrowLeft'&&idx>0){idx--;renderScene()}
  });

  renderScene();
})();
</script>
