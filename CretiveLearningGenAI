  var mE=document.getElementById('mExplore'),mW=document.getElementById('mWalk'),
      eV=document.getElementById('exploreView'),wV=document.getElementById('walkView'),hint=document.getElementById('hint');
  function setMode(explore){
    mE.classList.toggle('on',explore);mW.classList.toggle('on',!explore);
    mE.setAttribute('aria-selected',explore);mW.setAttribute('aria-selected',!explore);
    eV.classList.toggle('hide',!explore);wV.classList.toggle('hide',explore);
    hint.textContent=explore?'Hover a component to see the planes it serves. Click any plane or component for detail.':'A single architecture task, walked through the four planes with the visuals from the paper.';
    if(!explore){closePanel();renderScene();}
  }
  mE.addEventListener('click',function(){setMode(true)});
  mW.addEventListener('click',function(){setMode(false)});

